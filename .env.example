LLM_PROVIDER=lmstudio
# Address for runs from the host (make dev, make llm-check, make eval-local).
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Address for the container; Compose defaults to LM Studio on the host. For
# LLM_PROVIDER=cloud set it to the same URL as LLM_BASE_URL.
# LLM_DOCKER_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SEC=120
# Whole run, queue wait included. Keep below LLM_SERVICE_TIMEOUT_SEC in core-api (180).
LLM_RUN_BUDGET_SEC=170
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_WAIT_SEC=30
LLM_MAX_TOKENS=1536
HTTP_PORT=9000
LOG_LEVEL=INFO
